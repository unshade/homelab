# Talos: everything generated via the commands in talos/README.md - fully throwaway,
# regenerated from talos/secrets-sops-all.yaml + talos/patches/ on demand. Only
# talos/kubeconfig.enc.yaml (see talos/scripts/) and talos/secrets-sops-all.yaml
# are committed.
talos/out/

secrets

# Decrypted copies of *-sops.yaml secrets (see scripts/decrypt-sops-secrets.sh) -
# convenience-only, regenerated locally, never committed.
*-sops.dec.yaml

# VPS's WireGuard private key - not part of the Talos-managed fleet, cheap to
# regenerate if lost, so no SOPS backup (see vps/README.md).
vps/wireguard/wg0.conf

# Terraform (router/): local state, plugin cache, plans, and deployment-local
# values (current WAN lease, WireGuard peer keys) - the encrypted state
# (router/terraform-state.gpg) is what's committed, see router/README.md.
router/.terraform/
router/terraform.tfstate
router/terraform.tfstate.backup
router/*.tfplan
router/terraform.tfvars
